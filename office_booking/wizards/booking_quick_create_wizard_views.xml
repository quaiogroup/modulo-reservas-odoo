<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_spoot_booking_quick_create_wizard_form" model="ir.ui.view">
    <field name="name">office.booking.wizard.form</field>
    <field name="model">office.booking.wizard</field>
    <field name="arch" type="xml">
      <form string="Crear reserva rápida">
        <sheet>

          <group string="Datos de la reserva">
            <field name="office_id"/>
            <field name="office_pricing_mode" invisible="1"/>
            <field name="partner_id"/>
            <field name="date"/>
            <!-- Modo jornadas -->
            <field name="slot_type"
                   invisible="office_pricing_mode == 'hourly'"
                   required="office_pricing_mode != 'hourly'"/>
            <!-- Modo por horas -->
            <field name="hour_start"
                   invisible="office_pricing_mode != 'hourly'"
                   required="office_pricing_mode == 'hourly'"
                   widget="float_time"
                   string="Hora inicio"/>
            <field name="hour_end"
                   invisible="office_pricing_mode != 'hourly'"
                   required="office_pricing_mode == 'hourly'"
                   widget="float_time"
                   string="Hora fin"/>
          </group>

          <group string="Método de pago">
            <field name="payment_mode" widget="radio"/>
            <field name="subscription_id"
                   invisible="payment_mode != 'plan'"
                   required="payment_mode == 'plan'"
                   string="Plan activo del cliente"/>
          </group>

          <group string="Días / Recurrencia">
            <field name="recurrence_type" widget="radio"/>
            <field name="recurrence_end_date"
                   invisible="recurrence_type == 'none'"
                   required="recurrence_type != 'none'"
                   string="Repetir hasta"/>
            <div class="text-muted" colspan="2"
                 invisible="recurrence_type == 'none'">
              Se crearán automáticamente todas las reservas (mismo día) hasta la fecha indicada.
              Con pago por plan se descuentan los días de cada reserva.
            </div>
          </group>

          <div class="alert alert-info" role="alert"
               invisible="payment_mode != 'plan'">
            La reserva quedará <strong>confirmada</strong> y se descontarán los días del plan seleccionado.
          </div>
          <div class="alert alert-warning" role="alert"
               invisible="payment_mode != 'bold'">
            La reserva quedará en estado <strong>pendiente de pago</strong> hasta que Bold confirme el cobro.
          </div>

        </sheet>
        <footer>
          <button string="Crear reserva" type="object" name="action_create_booking" class="btn-primary"/>
          <button string="Cancelar" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
